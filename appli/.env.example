# Copie ce fichier en .env et remplis les valeurs (ou mets-les dans les variables EAS).

# Serveur Olaía (celui de l'appli iPad) : la carte du café.
EXPO_PUBLIC_OLAIA_API=https://olaia-commande.vercel.app

# FIMIO, où vit le Club Olaía.
EXPO_PUBLIC_FIMIO_BASE=https://www.fimio.fr
# Adresse courte (slug) du restaurant Olaía dans FIMIO. Vide : l'appli dit « le Club arrive bientôt ».
EXPO_PUBLIC_FIMIO_CLUB=
