# Copie ce fichier en .env.local et remplis les valeurs. Ne jamais committer .env.local.

# Supabase (compte Olaía) : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zelty (compte Olaía) : clé API à demander à Zelty (zelty.fr/forms/api).
# Sans clé, la borne affiche « carte pas encore reliée à Zelty », jamais de produits inventés.
ZELTY_API_KEY=
# Identifiant du restaurant Olaía dans Zelty (utile si la clé donne accès à plusieurs restaurants).
ZELTY_RESTAURANT_ID=
# Version de l'API (2.5 par défaut, celle qui tourne en production chez GREEKIA).
# ZELTY_API_BASE=https://api.zelty.fr/2.5

# Vidéo d'accueil de la borne (adresse d'un .mp4). Sans elle, la photo surf de la charte.
NEXT_PUBLIC_BORNE_VIDEO=

# FIMIO (Club Olaía) : la fidélité vit dans FIMIO, logiciel à part, avec un compte Olaía.
# Clé générée par le gérant dans FIMIO > Fidélité > Borne (affichée une seule fois).
# Sans clé, la borne affiche « Club pas encore relié à FIMIO », jamais de points inventés.
FIMIO_BORNE_CLE=
# FIMIO_BASE=https://www.fimio.fr
